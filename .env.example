# iDreyK 360 v0.4.1 — herramientas y configuración pública opcional del cliente.
# Gradle NO lee este archivo automáticamente. Linux/macOS: copiar a .env,
# editar rutas/valores y cargar explícitamente: set -a; . ./.env; set +a
# No subir .env ni local.properties ni claves privadas de firma.
JAVA_HOME="/ruta/al/jdk-21"
ANDROID_HOME="/ruta/al/Android/Sdk"
GRADLE_USER_HOME="${HOME}/.cache/idreyk-gradle"

# Dejar AMBOS vacíos mantiene la edición local, sin llamadas al servidor.
# Para conectar: URL de TU proyecto y clave PUBLICABLE real de Supabase.
# Se incorporan al APK; NO son secretos. RLS y permisos del servidor son obligatorios.
# Formatos: https://referencia-proyecto.supabase.co / sb_publishable_...
IDREYK_SUPABASE_URL=""
IDREYK_SUPABASE_PUBLISHABLE_KEY=""

# Gradle también acepta -PIDREYK_SUPABASE_URL y -PIDREYK_SUPABASE_PUBLISHABLE_KEY.
# Nunca añadir SUPABASE_SECRET_KEY, service_role, JWT_SECRET ni contraseña PostgreSQL
# al cliente. La configuración privada del operador es backend/.env.example.

# Opcional, SOLO para scripts/verificar_apk.py: huella PÚBLICA esperada del firmante.
# No es una clave y no se incorpora a BuildConfig. Dejar vacía en runners con firma temporal.
IDREYK_EXPECTED_CERT_SHA256=""

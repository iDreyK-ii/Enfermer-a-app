# iDreyK 360 — configuración OPCIONAL de herramientas de compilación.
# NO es configuración de un servidor y NO se incorpora al APK.
# Android/Gradle no carga archivos .env automáticamente.
# Linux/macOS: copia a .env, ajusta las rutas, revisa el archivo y luego:
#   set -a; . ./.env; set +a
# Si usas Android Studio, puedes configurar JDK/SDK desde el IDE.

# Ruta real de un JDK 17 o 21 instalado; no de un JRE.
JAVA_HOME="/ruta/al/jdk-21"

# SDK con cmdline-tools, platforms;android-35, build-tools;35.0.0 y platform-tools.
# Si hay local.properties, sdk.dir debe apuntar al mismo SDK.
ANDROID_HOME="/ruta/al/Android/Sdk"

# Caché de Gradle regenerable, fuera del código que se distribuye.
GRADLE_USER_HOME="${HOME}/.cache/idreyk-gradle"

# La app es local: no existen PORT, NODE_ENV, DB_HOST, DB_USER, DB_PASSWORD
# ni JWT_SECRET. No añadir credenciales ficticias ni cuentas de administrador.
# SQLite se llama idreyk_local.db y lo configura LocalDatabase en Repository.kt.
# No subir .env, local.properties ni claves de firma al repositorio.

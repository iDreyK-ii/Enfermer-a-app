{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paquete local iDreyK 360 — esquema 2",
  "description": "Contenido literal. La aplicación valida además UTF-8, 2 MB, 500 registros totales, IDs únicos por tipo, fechas reales, URL HTTPS sin credenciales, versiones enteras sin decimales y límites del catálogo agregado. Una revisión declarada requiere licencia del paquete; no equivale a certificación clínica. Los respaldos deben conservar los metadatos originales de cada ficha. Esquema 2 añade protocolos. Una exportación puede ser un respaldo vacío. v0.3 lee esquemas 1 y 2; v0.2 no admite esquema 2.",
  "type": "object",
  "required": [
    "version_esquema",
    "id_paquete",
    "version_contenido",
    "titulo",
    "autor",
    "fecha_actualizacion"
  ],
  "properties": {
    "version_esquema": {
      "const": 2,
      "type": "integer"
    },
    "tipo_paquete": {
      "enum": [
        "contenido",
        "respaldo_catalogo"
      ],
      "default": "contenido"
    },
    "id_paquete": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
    },
    "version_contenido": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999999
